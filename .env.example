# Shared
APP_ENV=development
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
PUBLIC_APP_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_MAX_UPLOAD_BYTES=25000000
NEXT_PUBLIC_REPORT_UNLOCK_AMOUNT=0
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_dGVzdC5jbGVyay5hY2NvdW50cy5kZXYk
# CLERK_SECRET_KEY=replace-with-clerk-secret-key
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_Z3JlYXQtYWRkZXItOTAuY2xlcmsuYWNjb3VudHMuZGV2JA
CLERK_SECRET_KEY=sk_test_a3hnTqMXNLxl1gQIYcMwDFrspIhiV8XMWKJPCRTIF5

# Backend auth
AUTH_SECRET=dev-only-auth-secret-change-me-at-least-32-characters
CLERK_ISSUER=https://your-clerk-instance.clerk.accounts.dev
CLERK_JWKS_URL=https://your-clerk-instance.clerk.accounts.dev/.well-known/jwks.json
CLERK_AUDIENCE=
AUTH_ALLOWED_ALGORITHM=RS256
# Local development only. Never set AUTH_BYPASS=true in Vercel production.
AUTH_BYPASS=true
PAYMENT_GATE_REPORTS=false

# Backend database
DATABASE_URL=postgresql+psycopg://mradi:mradi@localhost:5432/mradi
AUTO_CREATE_TABLES=false

# Storage
STORAGE_BACKEND=local
LOCAL_STORAGE_ROOT=./local-storage
GCS_BUCKET_NAME=
GCS_BUCKET=
GOOGLE_CLOUD_PROJECT=
GCP_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# Google AI, OCR, and agent runtime
GOOGLE_GENAI_USE_VERTEXAI=true
VERTEX_AI_LOCATION=us-central1
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
DOCUMENT_AI_PROCESSOR_ID=
DOCUMENT_AI_LOCATION=us
GCP_LOCATION=us
VERTEX_AI_AGENT_ENGINE_RESOURCE=
ADK_AGENT_CONFIG=

# Security and operations
UPLOAD_SIGNING_SECRET=dev-only-upload-secret-change-me
REPORT_SIGNING_SECRET=dev-only-report-secret-change-me
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=120
MAX_UPLOAD_BYTES=25000000
MAX_LOCAL_UPLOAD_MEMORY_BYTES=1048576
PERSIST_RAW_EXTRACTION_PAYLOADS=false
ENABLE_MALWARE_SCAN=false
CLAMD_HOST=localhost
CLAMD_PORT=3310
CSRF_COOKIE_NAME=csrf_token
CSRF_HEADER_NAME=x-csrf-token
CONTENT_SECURITY_POLICY=default-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src 'self'
LOG_LEVEL=INFO
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_PROFILES_SAMPLE_RATE=0.0
STATE_DEPARTMENT_LANDS_GAZETTE_URL=

# M-Pesa Daraja payments
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
MPESA_ENVIRONMENT=sandbox
